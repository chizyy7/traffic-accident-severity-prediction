    "# Select numerical columns for correlation analysis\n",
    "numerical_cols = df.select_dtypes(include=[np.number]).columns.tolist()\n",
    "# Remove ID-like columns and keep meaningful numerical features\n",
    "meaningful_numerical = [col for col in numerical_cols if col not in ['ID'] and \n",
    "                        not col.endswith('_encoded') and not 'Year' in col]\n",  # We'll add Year back if needed\n    "\n",
    "# Add back some temporal numerical features if they exist\n",
    "temporal_numerical = []\n",
    "for col in ['accident_year', 'accident_month', 'accident_day', 'accident_hour', 'accident_duration_minutes']:\n",
    "    if col in df.columns:\n",
    "        temporal_numerical.append(col)\n",
    "\n",
    "# Combine meaningful numerical features\n",
    "analysis_cols = list(set(meaningful_numerical + temporal_numerical))\n",
    "# Limit to reasonable number of columns for visualization\n",
    "if len(analysis_cols) > 10:\n",
    "    # Select most varied columns\n",
    "    analysis_cols = df[analysis_cols].var().nlargest(10).index.tolist()\n",
    "\n",
    "if len(analysis_cols) > 1:\n",
    "    # Calculate correlation matrix\n",
    "    correlation_matrix = df[analysis_cols].corr()\n",
    "    \n",
    "    # Create visualization\n",
    "    plt.figure(figsize=(12, 10))\n",
    "    mask = np.triu(np.ones_like(correlation_matrix, dtype=bool))  # Hide upper triangle\n",
