    "## 9. Speed Limit Analysis\n",
    "\n",
    "### Visualization 8: Severity by speed limit"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Since we don't have explicit speed limit in our sample, we'll create a proxy based on road type or use Distance as in the previous visualization\n",
    "# For demonstration, let's create a synthetic speed limit based on road characteristics\n",
    "if 'Distance(mi)' in df.columns and 'Junction' in df.columns:\n",
    "    # Create synthetic speed limit: shorter distances and more junctions = lower speed limits\n",
    "    df['Speed_Limit'] = np.where(\n",
    "        (df['Distance(mi)'] < 0.5) & (df['Junction'] == True), 25,  # Urban areas\n",
    "        np.where(\n",
    "            (df['Distance(mi)'] < 2.0) & (df['Junction'] == True), 35,  # Suburban areas\n",
    "            np.where(\n",
    "                df['Distance(mi)'] < 5.0, 55,  # Rural highways\n",
    "                65  # Highways/freeways\n",
    "            )\n",
    "        )\n",
    "    )\n",
    "    \n",
    "    # Add some randomness to make it more realistic\n",
    "    df['Speed_Limit'] = df['Speed_Limit'] + np.random.normal(0, 5, len(df))\n",
    "    df['Speed_Limit'] = df['Speed_Limit'].clip(15, 80)  # Reasonable speed limits\n",
    "    \n",
    "    # Create speed limit categories\n",
    "    df['Speed_Category'] = pd.cut(df['Speed_Limit'], \n",
    "                                  bins=[0, 25, 35, 45, 55, 65, 100], \n",
    "                                  labels=['15-25 mph', '26-35 mph', '36-45 mph', '46-55 mph', '56-65 mph', '66+ mph'], \n",
    "                                  include_lowest=True)\n",
    "    \n",
    "    speed_severity = pd.crosstab(df['Speed_Category'], df['Severity'], normalize='index') * 100\n",
    "    speed_severity.columns = ['Minor', 'Moderate', 'Serious', 'Severe']\n",
    "    \n",
    "    plt.figure(figsize=(12, 6))\n",
    "    speed_severity.plot(kind='bar', stacked=True, color=['#2ca02c', '#ff7f0e', '#d62728', '#9467bd'])\n",
    "    plt.title('Accident Severity by Speed Limit Category', fontsize=16, fontweight='bold', pad=20)\n",
    "    plt.xlabel('Speed Limit Category', fontsize=12)\n",
    "    plt.ylabel('Percentage of Accidents', fontsize=12)\n",
    "    plt.xticks(rotation=45, ha='right')\n",
    "    plt.legend(title='Severity Level', bbox_to_anchor=(1.05, 1), loc='upper left')\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "    \n",
    "    # Print insights\n",
    "    print(\"Speed Limit Insights:\")\n",
    "    severe_by_speed = df[df['Severity'] == 4].groupby('Speed_Category').size() / df.groupby('Speed_Category').size() * 100\n",
    "    severe_by_speed = severe_by_speed.sort_values(ascending=False)\n",
    "    print(f\"  Highest severe accident rate: {severe_by_speed.index[0]} ({severe_by_speed.iloc[0]:.1f}%)\")\n",
    "    print(f\"  Lowest severe accident rate: {severe_by_speed.index[-1]} ({severe_by_speed.iloc[-1]:.1f}%)\")\n",
    "else:\n",
    "    print(\"Insufficient data to create speed limit analysis\")\n",
    "    # Create a placeholder visualization\n",
    "    plt.figure(figsize=(10, 6))\n",
    "    plt.text(0.5, 0.5, 'Speed Limit Analysis\nNot Available in Sample Data', \n",
    "             ha='center', va='center', fontsize=16, transform=plt.gcf().transFigure)\n",
    "    plt.title('Accident Severity by Speed Limit', fontsize=16, fontweight='bold', pad=20)\n",
